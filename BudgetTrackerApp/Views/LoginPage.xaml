<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BudgetTrackerApp.ViewModels"
             x:Class="BudgetTrackerApp.Views.LoginPage"
             Title="Login"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        <Label Text="Budget Tracker Login" FontSize="Large" HorizontalOptions="Center" />

        <Entry Placeholder="Username" Text="{Binding Username}" Keyboard="Email" />
        <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True" />

        <Button Text="Login" Command="{Binding LoginCommand}" />
        <Button Text="Register" Command="{Binding GoToRegisterCommand}" HorizontalOptions="Center" FontAttributes="Bold" TextColor="Gray"/>

        <Label Text="{Binding LoginMessage}" TextColor="Red" HorizontalOptions="Center" />
    </VerticalStackLayout>

</ContentPage>