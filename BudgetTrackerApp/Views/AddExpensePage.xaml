<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BudgetTrackerApp.ViewModels"
             xmlns:model="clr-namespace:BudgetTrackerApp.Models"
             x:Class="BudgetTrackerApp.Views.AddExpensePage"
             Title="{Binding PageTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Description:" />
            <Entry Text="{Binding CurrentExpense.Description}" Placeholder="e.g., Groceries" />

            <Label Text="Amount:" />
            <Entry Text="{Binding CurrentExpense.Amount}" Placeholder="0.00" Keyboard="Numeric" />

            <Label Text="Date:" />
            <DatePicker Date="{Binding CurrentExpense.Date}" />

            <Label Text="Start Time:" />
            <TimePicker Time="{Binding CurrentExpense.StartTime}" />

            <Label Text="End Time:" />
            <TimePicker Time="{Binding CurrentExpense.EndTime}" />

            <Label Text="Category:" />
            <Picker Title="Select Category"
                    ItemsSource="{Binding Categories}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedCategory}" />
            <Button Text="{Binding PhotoButtonText}" Command="{Binding AddPhotoCommand}" Margin="0,15,0,0"/>
            <Label Text="{Binding CurrentExpense.PhotoPath}" FontSize="Micro" TextColor="Gray" IsVisible="{Binding CurrentExpense.PhotoPath, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
            <Image Source="{Binding CurrentExpense.PhotoPath}" HeightRequest="100" IsVisible="{Binding CurrentExpense.PhotoPath, Converter={StaticResource IsNotNullOrEmptyConverter}}" Aspect="AspectFit"/>


            <Button Text="Save Expense" Command="{Binding SaveExpenseCommand}" Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
