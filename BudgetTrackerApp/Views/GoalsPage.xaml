<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BudgetTrackerApp.ViewModels"
             x:Class="BudgetTrackerApp.Views.GoalsPage"
             Title="Monthly Goals">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Set Spending Goals" FontSize="Large" HorizontalOptions="Center"/>

        <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,10,0,10">
            <Button Grid.Column="0" Text="&lt; Prev" Command="{Binding PreviousMonthCommand}" />
            <Label Grid.Column="1" Text="{Binding SelectedMonthDisplay}" FontSize="Medium" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Button Grid.Column="2" Text="Next &gt;" Command="{Binding NextMonthCommand}" />
        </Grid>

        <Label Text="Minimum Monthly Spending Goal:" />
        <Entry Placeholder="0.00" Text="{Binding MinSpendingGoal}" Keyboard="Numeric" />

        <Label Text="Maximum Monthly Spending Goal:" />
        <Entry Placeholder="0.00" Text="{Binding MaxSpendingGoal}" Keyboard="Numeric" />

        <Button Text="Save Goal for Selected Month" Command="{Binding SaveGoalCommand}" Margin="0,20,0,0"/>

        <Label Text="{Binding StatusMessage}" TextColor="Gray" HorizontalOptions="Center" Margin="0,10,0,0"/>

    </VerticalStackLayout>
</ContentPage>
